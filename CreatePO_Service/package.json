{
  "name": "shopify-automation",
  "version": "1.0.0",
  "description": "Minimal ZeroStep Playwright automation project",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:shopify": "playwright test tests/shopify.spec.ts --headed",
    "test:shopify-ai": "playwright test tests/shopify-ai.spec.ts --headed",
    "start": "tsx server.ts",
    "server": "tsx server.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/express": "^4.17.21",
    "@types/node": "^25.0.3",
    "@zerostep/playwright": "^0.1.5",
    "dotenv": "^17.2.3",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "tsx": "^4.7.0"
  }
}
